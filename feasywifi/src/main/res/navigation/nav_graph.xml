<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/homeFragment">

    <include app:graph="@navigation/communication" />

    <include app:graph="@navigation/setting" />

    <include app:graph="@navigation/about" />

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.feasycom.feasywifi.ui.splash.SplashFragment"
        android:label="HomeFragment">
        <action
            android:id="@+id/action_homeFragment_to_setting"
            app:destination="@id/setting"
            app:popUpTo="@id/homeFragment"
            app:popUpToInclusive="true" />
    </fragment>

</navigation>