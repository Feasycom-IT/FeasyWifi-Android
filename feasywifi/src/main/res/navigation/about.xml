<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/about"
    app:popUpToInclusive="true"
    app:startDestination="@id/aboutFragment">

    <fragment
        android:id="@+id/aboutFragment"
        android:name="com.feasycom.feasywifi.ui.AboutFragment"
        android:label="AboutFragment">
        <action
            android:id="@+id/action_aboutFragment_to_feedbackFragment"
            app:destination="@id/feedbackFragment" />
        <action
            android:id="@+id/action_aboutFragment_to_agreementFragment"
            app:destination="@id/agreementFragment">
            <argument
                android:name="agreement_type"
                android:defaultValue="0"
                app:argType="integer" />
        </action>
        <action
            android:id="@+id/action_aboutFragment_to_qrFragment"
            app:destination="@id/qrFragment" />
        <action
            android:id="@+id/action_aboutFragment_to_aboutDetailsFragment"
            app:destination="@id/aboutDetailsFragment" />
    </fragment>

    <fragment
        android:id="@+id/feedbackFragment"
        android:name="com.feasycom.feasywifi.ui.feedback.FeedbackFragment"
        android:label="FeedbackFragment" />

    <fragment
        android:id="@+id/agreementFragment"
        android:name="com.feasycom.feasywifi.ui.agreement.AgreementFragment"
        android:label="AgreementFragment">
        <argument
            android:name="agreement_type"
            android:defaultValue="0"
            app:argType="integer" />
    </fragment>

    <fragment
        android:id="@+id/qrFragment"
        android:name="com.feasycom.feasywifi.ui.QrFragment"
        android:label="QrFragment" />

    <fragment
        android:id="@+id/aboutDetailsFragment"
        android:name="com.feasycom.feasywifi.ui.AboutDetailsFragment"
        android:label="AboutDetailsFragment" />

</navigation>